# Copy to .env and fill in. .env is git-ignored: never commit real values.
APPDATA=/home/you/appdata

# shared login in front of every public site
GATE_USER=guest
GATE_PASS=change-me
GATE_COOKIE_SECRET=generate-64-random-chars
GATE_TITLE=Sign in
GATE_COOKIE_NAME=homelab_gate

# HTTP basic auth for Subsonic music apps on music.DOMAIN/rest/*
# hash with: docker run --rm caddy:2.11.4 caddy hash-password --plaintext 'the-password'
# keep the single quotes: the hash contains $ signs
SUBSONIC_GUEST_USER=guest
SUBSONIC_GUEST_BCRYPT='$2a$14$replace-with-a-real-bcrypt-hash'
